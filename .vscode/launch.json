{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Setup 1: Select Operating System",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "tools.configuration",
      "args": ["config"],
      "preLaunchTask": "Setup 1: Select Operating System",
      "console": "internalConsole",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Setup 2: Install Python Virtual Environment",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "tools.configuration",
      "args": ["config"],
      "preLaunchTask": "Setup 2: Install Python Virtual Environment",
      "console": "internalConsole",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Setup 3: Install Ollama and Local LLM",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "tools.configuration",
      "args": ["config"],
      "preLaunchTask": "Setup 3: Install Ollama and Local LLM",
      "console": "internalConsole",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Check 1: Refresh Environment Check File",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "tools.configuration",
      "args": ["config"],
      "preLaunchTask": "Check: Refresh Environment Check File",
      "console": "internalConsole",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Run 3: Extension Module",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "tools.extension_runner",
      "args": ["--module", "tools.extensions.example"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Test Result: Generate Latest Markdown",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "test_result",
      "args": ["--docs"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Debug: Current Python File",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Debug: Current pytest File",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "pytest",
      "args": ["${file}", "-s", "-vv"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
