{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File (.venv)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "pytest: Current Test File",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-s", "-vv"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "CT: UART Timing",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/pytest/test_cases/timing/test_uart_timing.py", "-m", "ct", "-s", "-vv"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Tool: Analysis and Markdown Report",
      "type": "debugpy",
      "request": "launch",
      "module": "tools.pipeline",
      "args": ["--docs"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
